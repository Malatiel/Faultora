#!/bin/sh
set -eu

PRG=$0
case $PRG in
    */*) ;;
    *) PRG=$(command -v "$PRG") ;;
esac
while [ -L "$PRG" ]; do
    BIN_DIR=$(CDPATH= cd -- "${PRG%/*}" && pwd -P)
    LINK=$(readlink "$PRG")
    case $LINK in
        /*) PRG=$LINK ;;
        *) PRG=$BIN_DIR/$LINK ;;
    esac
done
APP_HOME=$(CDPATH= cd -- "${PRG%/*}/.." && pwd -P)
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=java
fi

exec "$JAVA" -jar "$APP_HOME/lib/faultora-${project.version}.jar" "$@"
