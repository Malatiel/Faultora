<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.faultora</groupId>
        <artifactId>faultora-parent</artifactId>
        <version>0.7.0</version>
    </parent>

    <artifactId>faultora-cli</artifactId>
    <name>Faultora :: CLI</name>
    <description>Command-line interface and composition root</description>

    <dependencies>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-model</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-spec</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-import-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-import-asyncapi</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-connector-http</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-connector-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-faults-local</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-faults-toxiproxy</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-assertions-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-reporting</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/..</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                    <include>THIRD-PARTY.txt</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>dev.faultora.cli.FaultoraCli</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <finalName>faultora-${project.version}</finalName>
                    <shadedArtifactAttached>true</shadedArtifactAttached>
                    <shadedClassifierName>all</shadedClassifierName>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/versions/**/module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                            <projectName>Faultora</projectName>
                            <organizationName>Malatiel</organizationName>
                            <inceptionYear>2026</inceptionYear>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                            <resource>META-INF/LICENSE-faultora.txt</resource>
                            <file>${project.basedir}/../LICENSE</file>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                            <resource>META-INF/NOTICE-faultora.txt</resource>
                            <file>${project.basedir}/../NOTICE</file>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>dev.faultora.cli.FaultoraCli</mainClass>
                            <manifestEntries>
                                <Implementation-Title>Faultora CLI</Implementation-Title>
                                <Implementation-Version>${project.version}</Implementation-Version>
                            </manifestEntries>
                        </transformer>
                    </transformers>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
