<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.faultora</groupId>
    <artifactId>faultora-parent</artifactId>
    <version>0.8.0</version>
    <packaging>pom</packaging>

    <name>Faultora</name>
    <description>Self-hosted reliability testing platform for APIs and distributed systems</description>
    <url>https://github.com/Malatiel/Faultora</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <!-- Build -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <project.build.outputTimestamp>2026-07-23T00:00:00Z</project.build.outputTimestamp>

        <!-- Java -->
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- Dependency versions -->
        <jackson.version>2.21.3</jackson.version>
        <jackson-annotations.version>2.21</jackson-annotations.version>
        <snakeyaml.version>2.5</snakeyaml.version>
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.5.34</logback.version>
        <junit.version>5.10.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <jmespath.version>0.5.1</jmespath.version>
        <kafka-clients.version>3.9.1</kafka-clients.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <h2.version>2.4.240</h2.version>
        <postgresql.version>42.7.3</postgresql.version>
        <httpclient5.version>5.6.1</httpclient5.version>
        <httpcore5.version>5.4.3</httpcore5.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.3.1</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.3.1</maven-failsafe-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <maven-shade-plugin.version>3.5.0</maven-shade-plugin.version>
        <maven-dependency-plugin.version>3.7.1</maven-dependency-plugin.version>
        <jacoco-plugin.version>0.8.12</jacoco-plugin.version>
        <spotless-plugin.version>2.43.0</spotless-plugin.version>
    </properties>

    <modules>
        <module>faultora-model</module>
        <module>faultora-spi</module>
        <module>faultora-spec</module>
        <module>faultora-schema</module>
        <module>faultora-net</module>
        <module>faultora-engine</module>
        <module>faultora-import-common</module>
        <module>faultora-import-openapi</module>
        <module>faultora-import-asyncapi</module>
        <module>faultora-import-observations</module>
        <module>faultora-connector-http</module>
        <module>faultora-connector-kafka</module>
        <module>faultora-connector-jdbc</module>
        <module>faultora-faults-local</module>
        <module>faultora-faults-toxiproxy</module>
        <module>faultora-assertions-core</module>
        <module>faultora-reporting</module>
        <module>faultora-cli</module>
        <module>faultora-testkit</module>
        <module>examples/payment-service</module>
        <module>examples/payment-worker</module>
        <module>examples/payment-recovery</module>
        <module>integration-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-spec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-schema</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-net</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-connector-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-import-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-import-openapi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-import-asyncapi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-import-observations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-connector-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-connector-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-faults-local</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-faults-toxiproxy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-assertions-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-reporting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.faultora</groupId>
                <artifactId>faultora-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Jackson (JSON processing) -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson-annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- YAML -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- JMESPath -->
            <dependency>
                <groupId>io.burt</groupId>
                <artifactId>jmespath-jackson</artifactId>
                <version>${jmespath.version}</version>
            </dependency>
            <dependency>
                <groupId>io.burt</groupId>
                <artifactId>jmespath-core</artifactId>
                <version>${jmespath.version}</version>
            </dependency>

            <!-- Kafka clients (event publish and observation) -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka-clients.version}</version>
            </dependency>

            <!-- Database drivers. H2 exercises the connector's bounds and
                 refusals offline; PostgreSQL is what the reference system and
                 the release gate run against. -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- Disposable infrastructure for the event end-to-end suite -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>kafka</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- and for the cross-component gate, which needs a real database -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Apache HttpClient 5 (DNS-resolving transport for SSRF pinning) -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Enforce dependency direction rules -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>3.9.0</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- model must not depend on SPI, engine, or implementations -->
                                        <!-- spi must not depend on engine or implementations -->
                                        <!-- engine must not depend on connector/importer implementations -->
                                        <exclude>commons-logging:commons-logging</exclude>
                                        <exclude>log4j:log4j</exclude>
                                        <exclude>javax.servlet:javax.servlet-api</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Reproducible builds -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <pom>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </pom>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
