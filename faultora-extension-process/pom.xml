<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.faultora</groupId>
        <artifactId>faultora-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>faultora-extension-process</artifactId>
    <name>Faultora :: Extension Child Lifecycle</name>
    <description>Verified artifact staging, supervised extension peers and the assertion adapter</description>
    <dependencies>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-process</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-extension-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.faultora</groupId>
            <artifactId>faultora-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource>
                <directory>../faultora-spi/src/test/resources</directory>
                <includes>
                    <include>extension-wire-v1/assertion-*.json</include>
                    <include>extension-wire-v1/import-*.json</include>
                </includes>
            </testResource>
        </testResources>
    </build>
</project>
